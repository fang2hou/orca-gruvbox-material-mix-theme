{
  "base": "dark",
  "tokens": {
    "--background": "#282828",
    "--editor-surface": "#282828",
    "--foreground": "#e2cca9",
    "--card": "#282828",
    "--card-foreground": "#e2cca9",
    "--popover": "#32302f",
    "--popover-foreground": "#e2cca9",
    "--primary": "#b0b846",
    "--primary-foreground": "#282828",
    "--secondary": "#3c3836",
    "--secondary-foreground": "#e2cca9",
    "--muted": "#3c3836",
    "--muted-foreground": "#bbaa90",
    "--accent": "#45403d",
    "--accent-foreground": "#e2cca9",
    "--border": "#45403d",
    "--input": "#32302f",
    "--ring": "#b0b846",
    "--sidebar": "#282828",
    "--sidebar-foreground": "#e2cca9",
    "--sidebar-accent": "#45403d",
    "--sidebar-accent-foreground": "#e2cca9",
    "--sidebar-border": "#45403d",
    "--sidebar-ring": "#b0b846",
    "--worktree-sidebar": "#282828",
    "--worktree-sidebar-border": "#45403d",
    "--chart-1": "#b0b846",
    "--chart-2": "#f28534",
    "--chart-3": "#80aa9e",
    "--chart-4": "#d3869b",
    "--chart-5": "#e9b143",
    "--tab-bar": "#1b1b1b",
    "--tab-active": "#282828",
    "--tab-active-foreground": "#e2cca9",
    "--tab-active-indicator": "#b0b846",
    "--tab-inactive": "#1b1b1b",
    "--tab-inactive-foreground": "#bbaa90",
    "--split-divider": "#45403d",
    "--split-divider-hover": "#b0b846",
    "--text-link": "#80aa9e",
    "--editor-selection": "#e2cca926",
    "--diff-added": "#b0b846",
    "--diff-removed": "#f2594b",
    "--diff-added-background": "#34381b",
    "--diff-removed-background": "#402120",
    "--git-decoration-added": "#b0b846",
    "--git-decoration-modified": "#e9b143",
    "--git-decoration-deleted": "#f2594b",
    "--git-decoration-renamed": "#80aa9e",
    "--git-decoration-untracked": "#8bba7f",
    "--git-decoration-copied": "#8bba7f",
    "--git-decoration-ignored": "#928374"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#928374",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "support.variable"
      ],
      "settings": {
        "foreground": "#80aa9e"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant",
        "support.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#8bba7f"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#d3869b"
      }
    },
    {
      "name": "Booleans",
      "scope": [
        "constant.language.boolean",
        "constant.language.true",
        "constant.language.false"
      ],
      "settings": {
        "foreground": "#d3869b"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "variable.language"
      ],
      "settings": {
        "foreground": "#f2594b"
      }
    },
    {
      "name": "Storage modifiers",
      "scope": [
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#f28534"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#f28534"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string",
        "markup.inline.raw",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#b0b846"
      }
    },
    {
      "name": "Escapes and regular expressions",
      "scope": [
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#e9b143"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#b0b846"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#e9b143"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#e2cca9"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#f28534"
      }
    },
    {
      "name": "Attributes and keys",
      "scope": [
        "entity.other.attribute-name",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#b0b846"
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#d3869b"
      }
    },
    {
      "name": "Headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#f28534",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#80aa9e",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Quotes",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#928374",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#f2594b"
      }
    }
  ]
}
